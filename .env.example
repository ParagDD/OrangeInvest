# ==============================================================================
# Errand Agent - Environment Variables Template
# ==============================================================================
# NOTE: The agent runs 100% locally out-of-the-box using the built-in deterministic
# RuleModel and mock environment (Pure Python stdlib). No keys or external services
# are required to pass the test suite or run the CLI/Web console.
#
# If you wish to connect a live LLM (e.g. Azure OpenAI gpt-6-luna or Gemini),
# copy this file to `.env` and fill in your credentials below:
# ==============================================================================

# LLM Provider: "rule" (default offline rule parser) or "azure" / "gemini"
LLM_PROVIDER=azure

# Azure OpenAI Configuration (Optional)
AZURE_API_KEY=your_azure_api_key_here
AZURE_OPENAI_ENDPOINT=https://your-resource-name.cognitiveservices.azure.com/
AZURE_OPENAI_DEPLOYMENT=gpt-6-luna
AZURE_OPENAI_API_VERSION=2024-12-01-preview
AZURE_OPENAI_MAX_TOKENS=8192

# Fallback Settings
LLM_FALLBACK_ENABLED=true
LLM_FALLBACK_TARGET=azure-openai:gpt-6-luna
